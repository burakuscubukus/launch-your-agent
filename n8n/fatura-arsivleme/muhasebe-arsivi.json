      "id": "a19b296d-f83a-490a-8232-a6d2b80ac044",
      "name": "Gönderen Listesini Oku",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Her mailin eklerini ayrı satırlara çevirir; kurum, tür, ay klasörü ve dosya adını hazırlar.\n// Gönderen listede varsa oradaki kurum adı/tür kullanılır.\n// Listede yoksa ve mail bir fatura ise: tür = Fatura, kurum = gönderenin adı.\nconst AYLAR = ['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];\nconst TUR_KLASORU = {\n  'Banka': '1r7KXw1yXnMxvGWAQWojoGS9ALH50Fx3T',\n  'Fatura': '1w88uJWXOnBjLAFaIB6vsjAMYxBvrZfA0',\n};\nconst FATURA_KELIMELERI = /fatura|e-ar[sş]iv|earsiv|e-fatura|invoice|makbuz|receipt/i;\n\nconst liste = {};\nfor (const satir of $input.all()) {\n  const e = String(satir.json.email || '').trim().toLowerCase();\n  if (e) liste[e] = satir.json;\n}\n\nconst temizle = (s) => String(s || '').replace(/[\\\\/:*?\"<>|']/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 60);\n\nconst sonuc = [];\nconst mailler = $('Her Sabah 09:00 - Gmail').all();\nfor (let i = 0; i < mailler.length; i++) {\n  const mail = mailler[i];\n  const kimden = (mail.json.from && mail.json.from.value && mail.json.from.value[0]) || {};\n  const adres = String(kimden.address || '').toLowerCase();\n  const konu = String(mail.json.subject || '');\n  let kurum, tur;\n  if (liste[adres]) {\n    kurum = liste[adres].company;\n    tur = liste[adres].tur;\n  } else if (FATURA_KELIMELERI.test(konu + ' ' + (mail.json.text || ''))) {\n    kurum = temizle(kimden.name) || adres.split('@')[1] || 'Bilinmeyen';\n    tur = 'Fatura';\n  } else {\n    continue; // listede yok ve fatura değil → atla\n  }\n  const turKlasorId = TUR_KLASORU[tur];\n  if (!turKlasorId) throw new Error(`Gönderen listesinde bilinmeyen tür: \"${tur}\" (${adres})`);\n  kurum = temizle(kurum);\n\n  const tarih = (mail.json.date ? DateTime.fromISO(String(mail.json.date)) : DateTime.now()).setZone('Europe/Istanbul');\n  // Mail içindeki logo/imza resimlerini atla, sadece belgeleri (PDF, XML, Excel...) al\n  const belgeler = Object.values(mail.binary || {}).filter(d => !(d.mimeType || '').startsWith('image/'));\n  // Fatura listesine her mail için tek satır: varsa PDF, yoksa ilk belge\n  const anaBelge = belgeler.find(d => (d.mimeType || '').includes('pdf')) || belgeler[0];\n  for (const dosya of belgeler) {\n    sonuc.push({\n      json: {\n        company: kurum,\n        tur,\n        turKlasorId,\n        klasorAy: `${tarih.toFormat('yyyy-MM')} ${AYLAR[tarih.month - 1]}`,\n        dosyaAdi: `${tarih.toFormat('yyyy-MM-dd')}_${kurum}_${dosya.fileName}`,\n        tarih: tarih.toFormat('dd.MM.yyyy'),\n        konu,\n        gonderen: adres,\n        listeyeYaz: tur === 'Fatura' && dosya === anaBelge,\n      },\n      binary: { data: dosya },\n      pairedItem: { item: 0 },\n    });\n  }\n}\nreturn sonuc;"
      },
